# Supabase 연결 정보 예시 (실제 값은 .env 에 넣고, .env 는 GitHub에 올리지 않습니다)
# Supabase 대시보드 > Project Settings > API 에서 확인할 수 있어요.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# 공개용(publishable/anon) 키만 사용합니다. service_role 키는 절대 넣지 마세요.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
STORAGE_BUCKET=portfolio-media
